{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "config/**/*.ts",
    "*.config.ts",
