      "types": "./dist/popover.d.mts",
      "import": "./dist/popover.mjs",
      "default": "./dist/popover.mjs"
    },
    "./scroll-area": {
      "types": "./dist/scroll-area.d.mts",
      "import": "./dist/scroll-area.mjs",
      "default": "./dist/scroll-area.mjs"
    },
    "./select": {
      "types": "./dist/select.d.mts",
      "import": "./dist/select.mjs",
      "default": "./dist/select.mjs"
    },
    "./separator": {
      "types": "./dist/separator.d.mts",
      "import": "./dist/separator.mjs",
      "default": "./dist/separator.mjs"
    },
    "./skeleton": {
      "types": "./dist/skeleton.d.mts",
      "import": "./dist/skeleton.mjs",
      "default": "./dist/skeleton.mjs"
    },
    "./spinner": {
      "types": "./dist/spinner.d.mts",
      "import": "./dist/spinner.mjs",
      "default": "./dist/spinner.mjs"
    },
    "./switch": {
      "types": "./dist/switch.d.mts",
      "import": "./dist/switch.mjs",
      "default": "./dist/switch.mjs"
    },
    "./toast": {
      "types": "./dist/toast.d.mts",
      "import": "./dist/toast.mjs",
      "default": "./dist/toast.mjs"
    },
    "./package.json": "./package.json",
    "./styles.css": "./src/styles/globals.css"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:browser": "vp test --project browser --run"
