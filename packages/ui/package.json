{
  "name": "@bruno/shadcn",
  "version": "0.0.0",
  "description": "Base UI-powered shadcn components for BrunoTable and other React applications.",
  "homepage": "https://github.com/bmvantunes/rust-view-server-and-table/tree/master/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/bmvantunes/rust-view-server-and-table/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmvantunes/rust-view-server-and-table.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist/*.d.mts",
    "dist/*.mjs",
    "src/styles/globals.css",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./alert": {
      "types": "./dist/alert.d.mts",
      "import": "./dist/alert.mjs",
      "default": "./dist/alert.mjs"
    },
    "./alert-dialog": {
      "types": "./dist/alert-dialog.d.mts",
      "import": "./dist/alert-dialog.mjs",
      "default": "./dist/alert-dialog.mjs"
    },
    "./badge": {
      "types": "./dist/badge.d.mts",
      "import": "./dist/badge.mjs",
      "default": "./dist/badge.mjs"
    },
    "./button": {
      "types": "./dist/button.d.mts",
      "import": "./dist/button.mjs",
      "default": "./dist/button.mjs"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.mts",
      "import": "./dist/checkbox.mjs",
      "default": "./dist/checkbox.mjs"
    },
    "./direction": {
      "types": "./dist/direction.d.mts",
      "import": "./dist/direction.mjs",
      "default": "./dist/direction.mjs"
    },
    "./dropdown-menu": {
      "types": "./dist/dropdown-menu.d.mts",
