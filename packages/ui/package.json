      "default": "./dist/empty.mjs"
    },
    "./input": {
      "types": "./dist/input.d.mts",
      "import": "./dist/input.mjs",
      "default": "./dist/input.mjs"
    },
    "./native-select": {
      "types": "./dist/native-select.d.mts",
      "import": "./dist/native-select.mjs",
      "default": "./dist/native-select.mjs"
